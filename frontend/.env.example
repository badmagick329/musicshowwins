# Server-side Django API used by Next.js during local development and deployment.
DJANGO_API_BASE_URL=http://127.0.0.1:8000/api/v1

# Shared with Django. Authenticates cached frontend GET requests to the API.
INTERNAL_API_SECRET=

# Shared with Django. Protects the archive-cache invalidation endpoint.
CACHE_REVALIDATION_SECRET=

# Optional public support link rendered server-side on the About page.
SUPPORT_URL=
