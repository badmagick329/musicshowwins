# Local development defaults. Copy to .env and change values as needed.
SECRET_KEY=dev-only-insecure-secret-key
DEBUG=1
ALLOWED_HOSTS=127.0.0.1 localhost
BASE_URL=http://127.0.0.1:8000

DB_ENGINE=django.db.backends.postgresql
DB_NAME=musicshowwins
DB_USER=musicshowwins
DB_PASSWORD=musicshowwins
DB_HOST=127.0.0.1
DB_PORT=5432

# Wikimedia asks clients to identify themselves. GitHub Issues is the contact channel.
WIKI_AGENT=KpopWins/0.1 (https://github.com/badmagick329/musicshowwins/issues)

# Optional Discord webhook used only for private public correction reports.
DISCORD_CORRECTIONS_WEBHOOK_URL=

# Shared with Next.js. Authenticates cached frontend GET requests to Django.
INTERNAL_API_SECRET=

# Next.js endpoint and shared secret used after public archive data changes.
CACHE_REVALIDATION_URL=http://127.0.0.1:3000/api/revalidate
CACHE_REVALIDATION_SECRET=
